do = "sweep"
in = "_logo-80"
peak = "g0"
[[effect]]
do = "sweep"
in = "_logo-132"
peak = "g0"
[[item]]
key = "R"
do = "gosub ru/menu"
[[item]]
key = "E"
do = "gosub en/menu"
[[item]]
key = "L"
do = "gosub lt/menu"
[[item]]
key = "Q"
do = "logoff"
