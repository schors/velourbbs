+++
[[effect]]
do = "sweep"
at = [1, 2, 108, 2]
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[effect]]
do = "sweep"
in = "_foot"
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[item]]
key = "ESC"
do = "back"
+++

  {!hi}V E L O U R{!}      {!dim}Documentation{!}   {!dim}Development{!}   {!white}About the station{!}
