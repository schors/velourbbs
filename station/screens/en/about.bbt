[[item]]
key = "ESC"
do = "back"
+++

  {!hi}V E L O U R{!}      {!dim}Documentation{!}
  {!gold}───────────{!frame}{~─}{!} {!gold}■{!}  

{#if term.rows >= 43}

{/if}
  {!gold}■  About the station{!}

  Velour is BBS software. This station runs on Velour and shows
  its guides and features.

  {!dim}Source code{!}         https://github.com/schors/velourbbs
  {!dim}Your address{!}        {session.ip}
  {!dim}Time online{!}         {session.online}
  {!dim}Velour version{!}      {bbs.version}
  {!dim}Open sessions{!}       {bbs.sessions}
  {!dim}Station uptime{!}      {bbs.uptime}

  {!dim}Terminal{!}            {term.cols}x{term.rows}, {term.type                         }
  {!dim}Program{!}             {#if term.name == ""}no reply{#else}{term.name                         }{/if}
  {!dim}Colours{!}             {#if term.colors == 16777216}truecolor{#else}{term.colors}{/if}
  {!dim}Background{!}          {#if term.background == ""}unknown{/if}{#if term.background == "dark"}dark, {term.bg_color}{/if}{#if term.background == "light"}light, {term.bg_color}{/if}
  {!dim}Cyrillic width{!}      {#if term.ambiguous == 2}2 cells{#else}1 cell{/if}
{~}
  {!frame}{~─}{!}  
  {!hi}Esc{!} {!ctl}To menu{!}

{#if term.rows >= 25}

{/if}
