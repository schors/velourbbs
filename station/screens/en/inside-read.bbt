+++
file = "{arg.file}"
margin = [2, 2]
[[effect]]
do = "sweep"
at = [1, 2, 108, 2]
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[effect]]
do = "sweep"
in = "_foot-file"
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[item]]
key = "B"
do = "page prev"
when = "file.page > 1"
[[item]]
key = "SPACE"
do = "page next"
when = "not file.last"
[[item]]
key = "ESC"
do = "back"
+++

  {!hi}V E L O U R{!}      {!dim}Documentation{!}    {!white}Inside{!}    {!dim}About the station{!}
  {!gold}───────────{!frame}{~─}{!} {!ameth}■{!}  

  {!ameth}■{!gold}  Inside  ∙  {arg.title}{!}

  {!dim}{file.minutes} min read{!}

{>file}
{>_foot-file}
  {#if item.B}{!hi}B{!} {!ctl}Back{!}    {/if}{#if item.SPACE}{!hi}Space{!} {!ctl}Next{!}{#else}          {/if}{#if not item.B}          {/if}{~}{!hi}Esc{!} {!ctl}To list{!}    {!dim}{clock}{!}  

{#if term.rows >= 25}

{/if}
