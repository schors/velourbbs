+++
[[effect]]
do = "sweep"
at = [1, 3, 108, 1]
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[item]]
key = "ESC"
do = "back"
+++

  {!hi}V E L O U R{!}      {!dim}Dokumentacija    Sandara{!}
  {!gold}───────────{!frame}{~─}{!} {!gold}■{!}  

{#if term.rows >= 43}

{/if}
  {!gold}■  Apie stotį{!}

  Velour - BBS programa. Ši stotis veikia su Velour
  ir rodo jos vadovus ir galimybes.

  {!dim}Pirminis kodas{!}      https://github.com/schors/velourbbs
  {!dim}Jūsų adresas{!}        {session.ip}
  {!dim}Ryšio trukmė{!}        {session.online live}
  {!dim}Velour versija{!}      {bbs.version}
  {!dim}Atviri seansai{!}      {bbs.sessions live}
  {!dim}Stotis veikia{!}       {bbs.uptime live}

  {!dim}Terminalas{!}          {term.cols}x{term.rows}, {term.type                         }
  {!dim}Programa{!}            {#if term.name == ""}nėra atsakymo{#else}{term.name                         }{/if}
  {!dim}Spalvos{!}             {#if term.colors == 16777216}truecolor{#else}{term.colors}{/if}
  {!dim}Fonas{!}               {#if term.background == ""}nežinomas{/if}{#if term.background == "dark"}tamsus, {term.bg_color}{/if}{#if term.background == "light"}šviesus, {term.bg_color}{/if}
  {!dim}Kirilicos plotis{!}    {#if term.ambiguous == 2}2 langeliai{#else}1 langelis{/if}
{~}
  {!frame}{~─}{!}  
  {!hi}Esc{!} {!ctl}Į meniu{!}{~}{!dim}{clock}{!}  

