+++
file = "{arg.file}"
margin = [2, 2]
width = [68, 68]
align = "left"
[[effect]]
do = "sweep"
at = [1, 2, 108, 2]
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[effect]]
do = "sweep"
in = "_foot-file"
peak = "g0"
delay = 10
delay_spread = 8
every = 45
spread = 20
[[item]]
key = "B"
do = "page prev"
when = "file.page > 1"
[[item]]
key = "SPACE"
do = "page next"
when = "not file.last"
[[item]]
key = "ESC"
do = "back"
+++

  {!hi}V E L O U R{!}      {!white}Dokumentacija{!}    {!dim}Sandara{!}    {!dim}Apie stotį{!}
  {!gold}───────────{!frame}{~─}{!} {!emer}■{!}  

  {!emer}■{!gold}  Dokumentacija  ∙  {arg.title}{!}

  {!dim}{file.minutes} min skaitymo{!}

{>file}
{>_foot-file}
  {#if item.B}{!hi}B{!} {!ctl}Atgal{!}    {/if}{#if item.SPACE}{!hi}Tarpas{!} {!ctl}Toliau{!}{#else}             {/if}{#if not item.B}           {/if}{~}{!hi}Esc{!} {!ctl}Į sąrašą{!}    {!dim}{clock}{!}  

{#if term.rows >= 25}

{/if}
