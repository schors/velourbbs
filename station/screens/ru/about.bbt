+++
[[item]]
key = "ESC"
do = "back"
+++

  {!hi}V E L O U R{!}      {!dim}Тексты{!}
  {!gold}───────────{!frame}{~─}{!} {!gold}■{!}  

{#if term.rows >= 43}

{/if}
  {!gold}■  О станции{!}

  Velour - программа для BBS. Эта станция работает на Velour
  и показывает его руководства и возможности.

  {!dim}Исходный код{!}        https://github.com/schors/velourbbs
  {!dim}Ваш адрес{!}           {session.ip}
  {!dim}Вы на связи{!}         {session.online}
  {!dim}Версия Velour{!}       {bbs.version}
  {!dim}Открытые сеансы{!}     {bbs.sessions}
  {!dim}Станция работает{!}    {bbs.uptime}

  {!dim}Терминал{!}            {term.cols}x{term.rows}, {term.type                         }
  {!dim}Программа{!}           {#if term.name == ""}нет ответа{#else}{term.name                         }{/if}
  {!dim}Цвета{!}               {#if term.colors == 16777216}truecolor{#else}{term.colors}{/if}
  {!dim}Фон{!}                 {#if term.background == ""}не определён{/if}{#if term.background == "dark"}тёмный, {term.bg_color}{/if}{#if term.background == "light"}светлый, {term.bg_color}{/if}
  {!dim}Ширина кириллицы{!}    {#if term.ambiguous == 2}2 клетки{#else}1 клетка{/if}
{~}
  {!frame}{~─}{!}  
  {!hi}Esc{!} {!ctl}В меню{!}

{#if term.rows >= 25}

{/if}
