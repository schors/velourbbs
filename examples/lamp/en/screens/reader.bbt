+++
file = "{arg.file}"
margin = [7, 2]
[[item]]
key = "SPACE"
do = "page next"
when = "not file.last"
[[item]]
key = "B"
do = "page prev"
when = "file.page > 1"
[[item]]
key = "ESC"
do = "back"
+++
{>_head}
       {!title}{file.title}{!}
       {!dim}{#if meta.author != ""}{meta.author}  ∙  {/if}{file.minutes} min  ∙  page {file.page}/{file.pages}{!}

{>file}

  {!line}────────────────────────────────────────────────────────────────────────────{!}

    {#if item.SPACE}{!key}Space{!}  {!dim}next{!}   {/if}{#if item.B}{!key}B{!}  {!dim}prev{!}   {/if}{!key}Esc{!}  {!dim}list{!}

