name="pre-push refuses private text in a conflict resolution"
reset
base=$(git rev-parse HEAD)
git checkout -q -b side
printf 'side\n' >c.txt && git add c.txt && git commit -qm side
git checkout -q GH-5-test
printf 'main\n' >c.txt && git add c.txt && git commit -qm main
git merge -q side >/dev/null 2>&1
printf 'Jane Roe was here\n' >c.txt && git add c.txt && git commit -qm "GH-5: Merge side"
run check --push origin url <<<"refs/heads/GH-5-test $(git rev-parse HEAD) refs/heads/GH-5-test $(git rev-parse HEAD~1)"
refused
has "$T/err" "private name"
git reset -q --hard "$base"

name="pre-push asks for a fetch when the remote sha is unknown"
reset
run check --push origin url <<<"refs/heads/GH-5-test $(git rev-parse HEAD) refs/heads/GH-5-test 1111111111111111111111111111111111111111"
refused
has "$T/err" "git fetch"

name="pre-push ignores a removed private line"
reset
printf 'by Jane Roe\n' >g.txt
git add g.txt
git commit -qm "GH-5: Add g again"
git rm -q g.txt
git commit -qm "GH-5: Remove g"
respond GET '/pulls?state=closed&head=o%3AGH-5-test' 200 '[]'
run check --push origin url <<<"refs/heads/GH-5-test $(git rev-parse HEAD) refs/heads/GH-5-test $(git rev-parse HEAD~1)"
