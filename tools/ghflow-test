HEAD_SHA=$(git rev-parse HEAD)
REVIEW='{"model":"Reviewer 2","position":"Script","summary":"Two findings.",
  "findings":[{"path":"a.sh","line":2,"body":"Bug A."},{"path":"a.sh","line":40,"body":"Bug B."},
  {"body":"General C."}]}'

