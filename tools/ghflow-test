  '{"number":8,"state":"open","merged":false,"mergeable_state":"dirty","head":{"ref":"GH-5-test","sha":"s","repo":{"full_name":"o/r"}},"base":{"repo":{"full_name":"o/r"}}}'
respond GET '/pulls?state=all&per_page=100&page=1' 200 \
