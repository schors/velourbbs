#!/usr/bin/env bash
# Tests of tools/ghflow with a stub curl. Run: tools/ghflow-test
set -uo pipefail

GHFLOW=$(cd "$(dirname "$0")" && pwd)/ghflow
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT

# Test data that the scan refuses. Built from parts, so this file passes the pre-push hook.
H=/ho
HOMEPATH="${H}me/user/x"
FAKE_PAT="ghp_$(printf 'a%.0s' {1..36})"
TOKEN=tok_test_0123456789

mkdir -p "$T/bin" "$T/fix"
printf '%s\n' "$TOKEN" >"$T/token"
printf 'Jane Roe\n\nДарья\n' >"$T/names"
export GHFLOW_TOKEN_FILE=$T/token GHFLOW_NAMES_FILE=$T/names GHFLOW_AGENT="Test Model 1"
export FIX=$T/fix LOG=$T/log PATH=$T/bin:$PATH

# The stub curl logs each request and answers from $FIX.
cat >"$T/bin/curl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$LOG.argv"
cat >>"$LOG.cfg"
m=GET out= data= url=
while (($#)); do
  case $1 in
    -X) m=$2; shift 2 ;;
    -o) out=$2; shift 2 ;;
    --data-binary) data=${2#@}; shift 2 ;;
    -K | -H | -w) shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
p=${url#https://api.github.com/repos/o/r}
p=${p#https://api.github.com}
printf '%s %s\n' "$m" "$p" >>"$LOG"
[[ -n $data ]] && jq -c . "$data" >>"$LOG"
f=$FIX/$(printf '%s %s' "$m" "$p" | tr -c 'A-Za-z0-9' '_')
if [[ -f $f ]]; then
  head -n 1 "$f" | tr -d '\n'
  tail -n +2 "$f" >"$out"
else
  printf 404
  printf '{"message":"Not Found"}' >"$out"
fi
EOF
chmod +x "$T/bin/curl"

# A git repository with a GitHub origin and one maintainer.
REPO=$T/repo
git init -q -b GH-5-test "$REPO"
cd "$REPO" || exit 1
git config user.name Test
git config user.email test@example.com
git remote add origin https://github.com/o/r.git
mkdir .github
printf '# Owners\n* @Maint # @fake\nx@example.com\n' >.github/CODEOWNERS
git add .github
git commit -qm init
git update-ref refs/remotes/origin/main HEAD

fails=0
reset() { rm -f "$FIX"/* "$LOG"*; }
respond() { printf '%s\n%s\n' "$3" "$4" >"$FIX/$(printf '%s %s' "$1" "$2" | tr -c 'A-Za-z0-9' '_')"; }
run() {
  "$GHFLOW" "$@" >"$T/out" 2>"$T/err"
  status=$?
}
fail() {
  printf 'FAIL %s: %s\n' "$name" "$1"
  printf '  stdout: %s\n  stderr: %s\n' "$(cat "$T/out")" "$(cat "$T/err")"
  fails=$((fails + 1))
}
ok() { ((status == 0)) || fail "exit $status"; }
refused() { ((status != 0)) || fail "expected a failure"; }
has() { grep -qF -- "$2" "$1" 2>/dev/null || fail "$1 has no: $2"; }
hasnt() { ! grep -qF -- "$2" "$1" 2>/dev/null || fail "$1 has: $2"; }
nocall() { [[ ! -s $LOG ]] || fail "unexpected API call: $(head -n 1 "$LOG")"; }

name="check passes clean text"
reset
run check <<<"A plain text about the BBS."
ok

name="check refuses a GitHub token"
reset
run check <<<"key $FAKE_PAT"
refused
has "$T/err" "GitHub token"

name="check refuses the token from the token file"
reset
run check <<<"x $TOKEN y"
refused
has "$T/err" "the token"

name="check refuses a path in /home"
reset
run check <<<"see $HOMEPATH"
refused

name="check refuses a private name in any case"
reset
run check <<<"Thanks, JANE ROE."
refused
has "$T/err" "private name"

name="check folds the case of a non-ASCII name in the C locale"
reset
LC_ALL=C run check <<<"ДАРЬЯ"
refused

name="check matches whole words of a name"
reset
run check <<<"Jane Roes"
ok

name="comment posts the marker, keeps the token out of argv"
reset
