name="show tags maintainer and agent posts"
reset
respond GET /issues/5 200 '{"number":5,"title":"T","state":"open","labels":[],"user":{"login":"maint"},"body":"B"}'
respond GET '/issues/5/sub_issues?per_page=100&page=1' 200 '[]'
