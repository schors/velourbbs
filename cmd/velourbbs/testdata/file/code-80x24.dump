| 4 /* crc16 gives the CRC-16/XMODEM of the n bytes of p. */                     |
| 5 uint16_t crc16(const uint8_t *p, int n)                                      |
| 6 {                                                                            |
| 7         uint16_t crc = 0;                                                    |
| 8         int i;                                                               |
| 9                                                                              |
|10         while (n-- > 0) {                                                    |
|11                 crc ^= (uint16_t)*p++ << 8;                                  |
|12                 for (i = 0; i < 8; i++) {                                    |
|13                         if (crc & 0x8000)                                    |
|14                                 crc = (crc << 1) ^ 0x1021;      /* the pol...|
|15                         else                                                 |
|16                                 crc <<= 1;                                   |
|17                 }                                                            |
|18         }                                                                    |
|19         return crc;                                                          |
|20 }                                                                            |
